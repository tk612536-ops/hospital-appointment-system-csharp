@model ManagementPage
@{
    ViewData["Title"] = "Saatler ve uygunluk";
    var root = "/manager/facilities/" + Model.Facility.Id + "/schedule";
    var branchId = ViewData["BranchId"] is long selected && Model.Branches.Any(b => b.Id == selected) ? selected : Model.Branches.First().Id;
    var day = (DayOfWeek)ViewData["Day"]!;
    var periods = Model.Opening.Where(w => w.BranchId == branchId && w.Day == day).OrderBy(w => w.Opens).ToArray();
    var culture = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");
}
<partial name="_ManagementNavigation" model="Model" />
<section class="management-card mb-4"><h2>Şube çalışma saatleri</h2><p>Haftanın her günü için ayrı aralıklar belirleyin. Öğle arası için ayrı aralıklar girin; boş bırakılan gün kapalıdır. Saatler Türkiye yerel saatidir.</p>
    <form action="@root" method="get" class="row g-3 align-items-end mb-4">
        <div class="col-md-5"><label for="hours-select-branch" class="form-label">Şube</label><select id="hours-select-branch" name="branchId" class="form-select">@foreach (var branch in Model.Branches) { <option value="@branch.Id" selected="@(branch.Id == branchId)">@branch.Name</option> }</select></div>
        <div class="col-md-4"><label for="hours-select-day" class="form-label">Gün</label><select id="hours-select-day" name="day" class="form-select">@foreach (var item in Enum.GetValues<DayOfWeek>()) { <option value="@item" selected="@(item == day)">@culture.DateTimeFormat.GetDayName(item)</option> }</select></div>
        <div class="col-md-3"><button type="submit" class="btn btn-outline-primary">Saatleri göster</button></div>
    </form>
    <form action="@root/hours" method="post" asp-antiforgery="true" class="form-stack">
        <input name="BranchId" type="hidden" value="@branchId" /><input name="Day" type="hidden" value="@day" />
        <h3 class="h5">@Model.Branches.Single(b => b.Id == branchId).Name · @culture.DateTimeFormat.GetDayName(day)</h3>
        @for (var i = 0; i < Math.Max(4, periods.Length); i++)
        {
            <div class="row g-3"><div class="col-sm-6"><label for="hours-open-@i" class="form-label">@(i + 1). aralık · Açılış</label><input id="hours-open-@i" name="Periods[@i].Opens" type="time" value="@(i < periods.Length ? periods[i].Opens.ToString("HH:mm") : "")" class="form-control" /></div>
            <div class="col-sm-6"><label for="hours-close-@i" class="form-label">@(i + 1). aralık · Kapanış</label><input id="hours-close-@i" name="Periods[@i].Closes" type="time" value="@(i < periods.Length ? periods[i].Closes.ToString("HH:mm") : "")" class="form-control" /></div></div>
        }
        <p class="text-secondary mb-0">Kaydetme seçilen günün tüm aralıklarını değiştirir. Günü kapatmak için tüm aralıkları boşaltın. Mevcut gelecek uygunluklarını veya ayrılmış randevuları bozan değişiklikler reddedilir.</p>
        <button type="submit" class="btn btn-primary align-self-start">Günün saatlerini kaydet</button>
    </form>
    <details class="mt-4"><summary>Haftalık saatlerin tamamı</summary><div class="table-responsive"><table class="table"><caption>Şube açılış aralıkları</caption><thead><tr><th>Şube</th><th>Gün</th><th>Açılış</th><th>Kapanış</th></tr></thead><tbody>@foreach (var opening in Model.Opening.OrderBy(w => w.BranchId).ThenBy(w => w.Day).ThenBy(w => w.Opens)) { <tr><td>@Model.Branches.Single(b => b.Id == opening.BranchId).Name</td><td>@culture.DateTimeFormat.GetDayName(opening.Day)</td><td>@opening.Opens.ToString("HH:mm")</td><td>@opening.Closes.ToString("HH:mm")</td></tr> }</tbody></table></div></details>
</section>
<section class="management-card mb-4"><h2>Tarihli çalışan uygunluğu</h2><p>Çalışana önce aynı şubede hizmet atayın. Bir çalışan aynı saatlerde başka bir şubede çalışamaz. Aralığın tamamı şube saatleri içinde olmalıdır.</p>
    @if (!Model.Staff.Any(s => s.Active)) { <p>Önce etkin bir çalışan ekleyin ve hizmet atayın.</p> }
    else
    {
        <form action="@root/availability" method="post" asp-antiforgery="true" class="row g-3 align-items-end">
            <div class="col-md-4"><label for="availability-staff" class="form-label">Çalışan</label><select id="availability-staff" name="StaffId" class="form-select" required>@foreach (var employee in Model.Staff.Where(s => s.Active)) { <option value="@employee.Id">@employee.Name · @employee.Profession</option> }</select></div>
            <div class="col-md-4"><label for="availability-branch" class="form-label">Şube</label><select id="availability-branch" name="BranchId" class="form-select" required>@foreach (var branch in Model.Branches) { <option value="@branch.Id">@branch.Name</option> }</select></div>
            <div class="col-md-4"><label for="availability-date" class="form-label">Tarih</label><input id="availability-date" name="Date" type="date" value="@Model.SuggestedDate.ToString("yyyy-MM-dd")" class="form-control" required /></div>
            <div class="col-md-4"><label for="availability-start" class="form-label">Başlangıç</label><input id="availability-start" name="Start" type="time" class="form-control" required /></div>
            <div class="col-md-4"><label for="availability-end" class="form-label">Bitiş</label><input id="availability-end" name="End" type="time" class="form-control" required /></div>
            <div class="col-md-4"><button class="btn btn-primary" type="submit">Uygunluk ekle</button></div>
        </form>
    }
</section>
<section class="management-card"><h2>Kayıtlı uygunluklar</h2><p class="text-secondary">Düzenleme ve kaldırma, gelecekteki veya devam eden Onay Bekliyor / Onaylandı randevularını korumak zorundadır. Çalışan ve şube sonradan değiştirilemez.</p>
    @if (Model.Availability.Count == 0) { <p>Henüz uygunluk eklenmedi.</p> }
    @foreach (var dateGroup in Model.Availability.OrderBy(w => w.Date).ThenBy(w => w.Starts).GroupBy(w => w.Date))
    {
        <details class="management-detail"><summary>@dateGroup.Key.ToString("dd MMMM yyyy", culture) · @dateGroup.Count() aralık</summary>
        @foreach (var window in dateGroup)
        {
            <article class="border-top py-3 mt-3"><h3 class="h6">@window.Staff · @window.Branch · @window.Starts.ToString("HH:mm")–@window.Ends.ToString("HH:mm")</h3>
                <form action="@root/availability/@window.Id" method="post" asp-antiforgery="true" class="row g-3 align-items-end">
                    <div class="col-md-4"><label for="window-date-@window.Id" class="form-label">Tarih</label><input id="window-date-@window.Id" name="Date" type="date" value="@window.Date.ToString("yyyy-MM-dd")" class="form-control" required /></div>
                    <div class="col-md-3"><label for="window-start-@window.Id" class="form-label">Başlangıç</label><input id="window-start-@window.Id" name="Start" type="time" value="@window.Starts.ToString("HH:mm")" class="form-control" required /></div>
                    <div class="col-md-3"><label for="window-end-@window.Id" class="form-label">Bitiş</label><input id="window-end-@window.Id" name="End" type="time" value="@window.Ends.ToString("HH:mm")" class="form-control" required /></div>
                    <div class="col-md-2"><button class="btn btn-primary" type="submit">Kaydet</button></div>
                </form>
                <form action="@root/availability/@window.Id/remove" method="post" asp-antiforgery="true" class="mt-3"><button class="btn btn-outline-danger" type="submit">Bu uygunluğu kaldır</button></form>
            </article>
        }
        </details>
    }
</section>
