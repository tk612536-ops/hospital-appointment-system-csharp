@model ManagementPage
@{ ViewData["Title"] = "Hizmetler ve ücretler"; var root = "/manager/facilities/" + Model.Facility.Id + "/services"; }
<partial name="_ManagementNavigation" model="Model" />
<section class="management-card mb-4"><h2>Yeni sağlık hizmeti</h2>
    @if (Model.Departments.Count == 0) { <p>Önce <a href="/manager/facilities/@Model.Facility.Id">bir bölüm ekleyin</a>.</p> }
    else
    {
        <form action="@root" method="post" asp-antiforgery="true" class="row g-3 align-items-end">
            <div class="col-lg-3"><label for="service-department" class="form-label">Şube / bölüm</label><select id="service-department" name="DepartmentId" class="form-select" required>@foreach (var department in Model.Departments) { <option value="@department.Id">@department.Branch / @department.Name</option> }</select></div>
            <div class="col-lg-3"><label for="service-name" class="form-label">Hizmet adı</label><input id="service-name" name="Name" class="form-control" maxlength="255" required /></div>
            <div class="col-sm-4 col-lg-2"><label for="service-duration" class="form-label">Süre (dakika)</label><input id="service-duration" name="Duration" type="number" min="1" max="1439" value="30" class="form-control" required /></div>
            <div class="col-sm-4 col-lg-2"><label for="service-fee" class="form-label">Ücret (TRY)</label><input id="service-fee" name="Fee" inputmode="decimal" placeholder="Örn. 750,50" class="form-control" required /></div>
            <div class="col-sm-4 col-lg-2"><button class="btn btn-primary" type="submit">Hizmet ekle</button></div>
        </form>
    }
</section>
<section class="management-card"><h2>Hizmetler</h2><p class="text-secondary">Ücretleri virgülle ve en çok iki ondalık basamakla girin. Değişiklikler yeni randevulara uygulanır; kayıtlı randevuların süre, ücret ve adları korunur. Pasifleştirme geçmişi silmez.</p>
    @if (Model.Services.Count == 0) { <p>Henüz hizmet eklenmedi.</p> }
    @foreach (var service in Model.Services)
    {
        <article class="border-top py-4">
            <p><strong>@service.Branch / @service.Department</strong> · @(service.Active ? "Etkin" : "Pasif")</p>
            <form action="@root/@service.Id" method="post" asp-antiforgery="true" class="row g-3 align-items-end">
                <div class="col-md-4"><label for="service-name-@service.Id" class="form-label">Hizmet adı</label><input id="service-name-@service.Id" name="Name" value="@service.Name" class="form-control" maxlength="255" required /></div>
                <div class="col-md-2"><label for="service-duration-@service.Id" class="form-label">Süre (dakika)</label><input id="service-duration-@service.Id" name="Duration" type="number" min="1" max="1439" value="@service.Duration" class="form-control" required /></div>
                <div class="col-md-3"><label for="service-fee-@service.Id" class="form-label">Ücret (TRY)</label><input id="service-fee-@service.Id" name="Fee" inputmode="decimal" value="@service.Fee.ToString("0.00")" class="form-control" required /></div>
                <div class="col-md-3"><button class="btn btn-primary" type="submit">Kaydet</button></div>
            </form>
            <form action="@root/@service.Id/active" method="post" asp-antiforgery="true" class="mt-3"><input name="active" value="@((!service.Active).ToString().ToLowerInvariant())" type="hidden" /><button class="btn btn-outline-primary" type="submit">@(service.Active ? "Hizmeti pasifleştir" : "Hizmeti etkinleştir")</button></form>
        </article>
    }
</section>
