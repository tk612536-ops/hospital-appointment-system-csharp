@model AccountProfile
@{
    var role = (AccountRole)ViewData["Role"]!;
    var title = role switch { AccountRole.Patient => "Hasta alanı", AccountRole.Staff => "Personel alanı", _ => "Yönetici alanı" };
    ViewData["Title"] = title;
}
<section class="page-intro"><p class="eyebrow">@title.ToUpper(System.Globalization.CultureInfo.GetCultureInfo("tr-TR"))</p><h1>@Model.DisplayName</h1><p>Randevu ve kurum işlemleriniz için hızlı erişim.</p></section>
<section class="workspace-panel" aria-labelledby="workspace-heading">
    @if (role == AccountRole.Patient)
    {
        <h2 id="workspace-heading" class="mt-0">Sağlık hizmetinizi planlayın</h2><p>Kurum, hizmet ve çalışan seçin; uygun saatlerden randevu alın ve değerlendirme sonucunu takip edin.</p>
        <div class="d-flex flex-wrap gap-3"><a class="btn btn-primary" href="/patient/book">Randevu al</a><a class="btn btn-outline-primary" href="/patient/appointments">Randevularım</a></div>
    }
    else if (role == AccountRole.Staff)
    {
        <h2 id="workspace-heading" class="mt-0">Randevuları değerlendirin</h2><p>Size atanmış randevuların ayrıntılarını inceleyin. Onay Bekliyor durumundaki kayıtları onaylayın veya reddedin.</p>
        <a class="btn btn-primary" href="/work/appointments">Randevu değerlendirme</a>
    }
    else
    {
        <h2 id="workspace-heading" class="mt-0">Kurumunuzu ve takviminizi yönetin</h2><p>Yetkili olduğunuz kurumların şube, bölüm, hizmet, çalışan ve çalışma saatlerini düzenleyin; kurum randevularını değerlendirin.</p>
        <div class="d-flex flex-wrap gap-3"><a class="btn btn-primary" href="/manager/facilities">Kurum yönetimi</a><a class="btn btn-outline-primary" href="/work/appointments">Randevu değerlendirme</a></div>
    }
    <p class="coming-note mb-0"><a href="/workspace">Tüm çalışma alanlarım <span aria-hidden="true">→</span></a></p>
</section>
